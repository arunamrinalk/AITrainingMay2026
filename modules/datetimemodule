#import datetime

#from statement is used to import specific attributes or functions from a module, allowing you to use them directly without the module name prefix.
from datetime import UTC, datetime, timezone

timenow = datetime.now() #datetime.datetime.now() returns the current local date and time as a datetime object.
print("Current date and time:", timenow)
print(timenow.year) #datetime.datetime.year is an attribute that returns the year component of a datetime object as an integer.
print(timenow.month) #datetime.datetime.month is an attribute that returns the month component of a datetime object as an integer (1-12).
print(timenow.day) #datetime.datetime.day is an attribute that returns the day component of a datetime object as an integer (1-31).
print(timenow.hour) #datetime.datetime.hour is an attribute that returns the hour component of a datetime object as an integer (0-23).
print(timenow.minute) #datetime.datetime.minute is an attribute that returns the minute component of a datetime object as an integer (0-59).
print(timenow.second) #datetime.datetime.second is an attribute that returns the second component of


#difference between strftime and strptime is that strftime is used to format a datetime object into a string representation based on a specified format, 
#while strptime is used to parse a string representation of a date and time into a datetime object based on a specified format.
#datetime.datetime.strftime(format) is a method that formats a datetime object into a string representation based on the specified format string.
#datetime.datetime.strptime(date_string, format) is a method that parses a string representing a date and time according to a specified format and returns a corresponding datetime object.
custom_date = datetime.strftime(timenow, "%Y-%m-%d %H:%M:%S") #datetime.datetime.strftime(format) is a method that formats a datetime object into a string representation based on the specified format string.
print("Custom date format:", custom_date)

custom_date2 = datetime.strptime(custom_date, "%Y-%m-%d %H:%M:%S") #datetime.datetime.strptime(date_string, format) is a method that parses a string representing a date and time according to a specified format and returns a corresponding datetime object.
print("Parsed datetime object:", custom_date2)
#timezone = timezone.utc #datetime.timezone.utc is a timezone object representing Coordinated Universal Time (UTC).
#print("Timezone:", timezone)

timezoneUTC = datetime.now(timezone.utc) #datetime.datetime.now(datetime.timezone.utc) returns the current date and time in UTC as a datetime object.
print("Current date and time in UTC:", timezoneUTC)