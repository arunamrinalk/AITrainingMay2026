#nested loops
for i in range(3):
    for j in range(3):
        print(i, j)
        
#loop control statements
#break statement
for i in range(5):
    if i == 3:
        break
    print(i)
    
#continue statement
for i in range(5):
    if i == 3:
        continue
    print(i)
    
#pass statement
#The pass statement is a null statement in Python.
# It is used as a placeholder when a statement is required syntactically but you do not want to execute any code. 
# It allows you to create empty blocks of code without causing a syntax error.
for i in range(5):
    if i == 3:
        pass
    print(i)
    
#comparator operators in loops
#Comparator operators are used in loops to compare values and control the flow of the loop based on certain conditions.
# The most common comparator operators used in loops are:
# == (equal to)
# != (not equal to)
# < (less than)
# > (greater than)
# <= (less than or equal to)
# >= (greater than or equal to)
#These operators are used in the loop's condition to determine whether the loop should continue executing or not.
for i in range(5):
    if i < 3:
        print(i, "is less than 3")
    elif i == 3:
        print(i, "is equal to 3")
    else:
        print(i, "is greater than 3")
        
#logical operators in loops
#Logical operators are used in loops to combine multiple conditions and control the flow of the loop based on those conditions.
# The most common logical operators used in loops are:
# and (logical AND)
# or (logical OR)
# not (logical NOT)
#These operators are used in the loop's condition to determine whether the loop should continue executing or not based on the combined conditions.
for i in range(5):
    if i < 3 and i % 2 == 0:
        print(i, "is less than 3 and even")
    elif i == 3 or i % 2 != 0:
        print(i, "is equal to 3 or odd")
    else:
        print(i, "is greater than 3 and even")

