#throwing an exception manually using raise keyword
#raise keyword in python is used to manually raise an exception. 
#It allows you to create and throw an exception at any point in your code, which can be useful for handling specific error conditions or enforcing certain constraints.
def validate_age(age):
    if age < 0:
        raise ValueError("Age cannot be negative.") # this will raise a ValueError with the specified message if the age is negative.
    elif age < 18:
        raise ValueError("You must be at least 18 years old to register.") # this will raise a ValueError with the specified message if the age is less than 18.
    else:
        print("Age is valid. You can proceed with registration.")
        
def get_age_input():
    try:
        age = int(input("Enter your age: "))
        validate_age(age) # this will call the validate_age function with the user input, and it may raise a ValueError if the age is invalid. 
    except ValueError as ve:
        print("Error:", ve) # this will catch the ValueError raised by the validate_age function and print the error message to the user.
    finally:
        print("Thank you for providing your age. Please try again if you entered an invalid age.")
        
        
get_age_input() # this will call the get_age_input function, which will prompt the user to enter their age and validate it using the validate_age function. If the age is invalid, it will raise a ValueError and print the corresponding error message, but it will always execute the finally block to thank the user for providing their age.


